<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Moedix.ContentPageView"
             BackgroundColor="#121212">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" VerticalOptions="Start">
            <Button Text="←"
                    FontSize="26"
                    TextColor="#FFD700"
                    BackgroundColor="Transparent"
                    Clicked="OnBackClicked"
                    HorizontalOptions="Start"
                    VerticalOptions="Center" />

            <Label x:Name="PlayerCoinLabel"
                   Grid.Column="1"
                   Text="Moedas: 0 💰"
                   TextColor="#FFD700"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   Padding="0,0,10,0"/>
        </Grid>

        <BoxView Grid.Row="1" HeightRequest="1" Color="#333" Margin="0,10" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout x:Name="ContentList" Padding="0" Spacing="15">

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Button x:Name="HeaderButton1"
                                Text="🌟 1. Bem-vindo ao Mundo de Moedix ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo1" />

                        <StackLayout x:Name="Conteudo1Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="🐷✨ Você acaba de conhecer o Porquinho Alado, seu guia mágico no mundo das moedas! " />
                                        <Span Text="&#x0a;&#x0a;Ele vive em um reino inspirado na Grécia antiga, onde a sabedoria é ouro. Aqui, aprender sobre dinheiro é tão importante quanto aprender a voar!" />
                                        <Span Text="&#x0a;&#x0a;Cada escolha que você faz ajuda o porquinho a subir mais alto. Quanto mais você aprende, mais longe ele voa! 🕊️" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Button x:Name="HeaderButton2"
                                Text="💰 2. Aprendendo o Valor do Dinheiro ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo2" />

                        <VerticalStackLayout x:Name="LockPanel2" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White" HorizontalOptions="Center" FontAttributes="Italic"/>
                            <Button x:Name="UnlockButton2"
                                    Text="Desbloquear (Custo: 50 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E" FontAttributes="Bold"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo2" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo2Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="O dinheiro existe para ajudar as pessoas a trocarem coisas. Ele paga brinquedos, comida, roupas e muitas outras coisas." />
                                        <Span Text="&#x0a;&#x0a;Mas ele só existe porque alguém trabalhou para ganhá-lo. Cada moedinha representa esforço e dedicação." />
                                        <Span Text="&#x0a;&#x0a;Quando entendemos isso, começamos a usar o dinheiro com mais carinho e responsabilidade. ✨" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Button Text="▶️ Assistir vídeo"
                                    BackgroundColor="#FFD700"
                                    TextColor="#1E1E1E"
                                    FontAttributes="Bold"
                                    Clicked="OnVideoButtonClicked"
                                    CommandParameter="https://www.youtube.com/watch?v=OGbWdvEpw7o" />
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Button x:Name="HeaderButton3"
                                Text="🐷 3. Guardar e Planejar ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo3" />

                        <VerticalStackLayout x:Name="LockPanel3" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White" HorizontalOptions="Center" FontAttributes="Italic"/>
                            <Button x:Name="UnlockButton3"
                                    Text="Desbloquear (Custo: 100 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E" FontAttributes="Bold"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo3" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo3Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Guardar dinheiro é como plantar sementes. Você coloca um pouquinho hoje para colher algo muito maior no futuro! 🌱" />
                                        <Span Text="&#x0a;&#x0a;Planejar nos ajuda a entender o que queremos comprar e quando. Isso evita gastar com coisas que não precisamos." />
                                        <Span Text="&#x0a;&#x0a;O porquinho-cofre é seu melhor amigo nessa jornada! 🐽" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Button Text="▶️ Assistir vídeo"
                                    BackgroundColor="#FFD700"
                                    TextColor="#1E1E1E"
                                    FontAttributes="Bold"
                                    Clicked="OnVideoButtonClicked"
                                    CommandParameter="https://www.youtube.com/watch?v=naSJPA_54dE" />
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15" HasShadow="True">
                    <VerticalStackLayout>
                        <Button x:Name="HeaderButton4"
                                Text="🧩 4. Fazendo Boas Escolhas ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo4" />

                        <VerticalStackLayout x:Name="LockPanel4" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White" HorizontalOptions="Center"/>
                            <Button x:Name="UnlockButton4"
                                    Text="Desbloquear (Custo: 150 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo4" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo4Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Escolher bem é pensar antes de comprar. Nem tudo que queremos é realmente necessário!" />
                                        <Span Text="&#x0a;&#x0a;Às vezes, esperar é a chave para conseguir algo muito melhor." />
                                        <Span Text="&#x0a;&#x0a;Cada decisão é uma pecinha do quebra-cabeça da vida financeira! 🧠" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15">
                    <VerticalStackLayout>
                        <Button x:Name="HeaderButton5"
                                Text="💎 5. Criptomoedas: Dinheiro Digital ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo5" />

                        <VerticalStackLayout x:Name="LockPanel5" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White"/>
                            <Button x:Name="UnlockButton5"
                                    Text="Desbloquear (Custo: 200 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo5" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo5Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Criptomoedas são moedas digitais protegidas por códigos muito fortes." />
                                        <Span Text="&#x0a;&#x0a;Elas não ficam em bancos e viajam pela internet rapidamente." />
                                        <Span Text="&#x0a;&#x0a;É como ter um cofrinho invisível que só você pode abrir! 🔐" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Button Text="▶️ Assistir vídeo"
                                    BackgroundColor="#FFD700"
                                    TextColor="#1E1E1E"
                                    FontAttributes="Bold"
                                    Clicked="OnVideoButtonClicked"
                                    CommandParameter="https://www.youtube.com/watch?v=9uO5Hl_zKac" />
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15">
                    <VerticalStackLayout>
                        <Button x:Name="HeaderButton6"
                                Text="🔐 6. Criptografia: Protegendo Segredos e Moedas ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo6" />

                        <VerticalStackLayout x:Name="LockPanel6" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White"/>
                            <Button x:Name="UnlockButton6"
                                    Text="Desbloquear (Custo: 250 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo6" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo6Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Criptografia é como transformar o dinheiro digital em um tesouro secreto que só abre com a chave certa."/>
                                        <Span Text="&#x0a;&#x0a;Quando você envia moedas pela internet, elas não viajam sozinhas. Elas vão escondidas dentro de um cofre invisível cheio de códigos embaralhados, como se fossem letrinhas mágicas dançando."/>
                                        <Span Text="&#x0a;&#x0a;No mundo financeiro, bancos e aplicativos usam criptografia para proteger tudo: pagamentos, senhas, compras e até suas moedinhas guardadas. Ninguém consegue ver o que está acontecendo lá dentro, porque tudo fica embaralhado."/>
                                        <Span Text="&#x0a;&#x0a;Só quem tem a chave secreta — que pode ser uma senha, um token ou um código especial — consegue abrir o cofre e entender as informações. É como se cada pessoa tivesse sua própria chave mágica que só funciona no seu tesouro."/>
                                        <Span Text="&#x0a;&#x0a;Assim, a criptografia faz o dinheiro digital viajar seguro pelo mundo inteiro, sem medo de ladrões ou curiosos. É a magia que mantém o seu tesouro protegido. 🔑✨"/>
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Button Text="▶️ Assistir vídeo"
                                    BackgroundColor="#FFD700"
                                    TextColor="#1E1E1E"
                                    FontAttributes="Bold"
                                    Clicked="OnVideoButtonClicked"
                                    CommandParameter="https://www.youtube.com/watch?v=IhKXdt2SrdU" />
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15">
                    <VerticalStackLayout>
                        <Button x:Name="HeaderButton7"
                                Text="🏛️ 7. Sabedoria Grega: Ouro para a Vida ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo7" />

                        <VerticalStackLayout x:Name="LockPanel7" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White"/>
                            <Button x:Name="UnlockButton7"
                                    Text="Desbloquear (Custo: 300 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo7" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo7Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Os gregos valorizavam equilíbrio, esforço e sabedoria." />
                                        <Span Text="&#x0a;&#x0a;No Moedix, aprender sobre dinheiro também é aprender a ser mais sábio." />
                                        <Span Text="&#x0a;&#x0a;Esse é o verdadeiro tesouro: conhecimento!" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Button Text="▶️ Assistir vídeo"
                                    BackgroundColor="#FFD700"
                                    TextColor="#1E1E1E"
                                    FontAttributes="Bold"
                                    Clicked="OnVideoButtonClicked"
                                    CommandParameter="https://www.youtube.com/watch?v=BL5vUVQvmX4" />
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15">
                    <VerticalStackLayout>
                        <Button Text="🌐 8. Dinheiro Digital no Dia a Dia ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo8" />

                        <VerticalStackLayout x:Name="LockPanel8" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White"/>
                            <Button Text="Desbloquear (Custo: 350 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo8" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo8Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Muitas compras hoje são feitas usando dinheiro digital. Ele está no cartão, no celular e até nos games." />
                                        <Span Text="&#x0a;&#x0a;Ele é rápido, fácil e seguro quando usado com cuidado." />
                                        <Span Text="&#x0a;&#x0a;Usar dinheiro digital é como ter uma carteira invisível que funciona com um toque!" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15">
                    <VerticalStackLayout>
                        <Button Text="📱 9. Carteiras Digitais: Cofrinhos do Futuro ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo9" />

                        <VerticalStackLayout x:Name="LockPanel9" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White"/>
                            <Button Text="Desbloquear (Custo: 400 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo9" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo9Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Carteiras digitais são aplicativos onde você guarda seu dinheiro digital." />
                                        <Span Text="&#x0a;&#x0a;Elas funcionam como cofres inteligentes, protegidos por senha ou impressão digital." />
                                        <Span Text="&#x0a;&#x0a;Com elas, dá para pagar lanches, jogos e até enviar moedas para amigos!" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame CornerRadius="20" BackgroundColor="#1E1E1E" Padding="15">
                    <VerticalStackLayout>
                        <Button Text="🛡️ 10. Segurança Online para Crianças ▼"
                                BackgroundColor="Transparent" TextColor="#FFD700" FontAttributes="Bold"
                                Clicked="OnHeaderClicked"
                                CommandParameter="Conteudo10" />

                        <VerticalStackLayout x:Name="LockPanel10" IsVisible="True" Padding="10" HorizontalOptions="Center">
                            <Label Text="🔒 Conteúdo Bloqueado" TextColor="White"/>
                            <Button Text="Desbloquear (Custo: 450 💰)"
                                    BackgroundColor="#FFD700" TextColor="#1E1E1E"
                                    Clicked="OnUnlockClicked"
                                    CommandParameter="Conteudo10" />
                        </VerticalStackLayout>

                        <StackLayout x:Name="Conteudo10Body" IsVisible="False" Padding="10">
                            <Label TextColor="White" FontSize="16">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Para usar dinheiro digital, é importante saber se proteger. Nunca compartilhe senhas e sempre use dispositivos seguros." />
                                        <Span Text="&#x0a;&#x0a;Se algo parecer estranho, peça ajuda a um adulto." />
                                        <Span Text="&#x0a;&#x0a;Segurança é a chave para aproveitar o mundo digital com tranquilidade!" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
